# Provider selection: "anthropic" or "azure_openai"
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Azure OpenAI (used when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Per-task overrides (optional). Use a faster deployment for extract,
# a smarter one for classify. Falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_EXTRACT_DEPLOYMENT=
AZURE_OPENAI_CLASSIFY_DEPLOYMENT=

# --- Web search (Tavily) — wired in step 4 ---
TAVILY_API_KEY=

# Path for the JSONL chain log. Default: ./data/chains.jsonl (relative to cwd).
# Set to empty string to disable.
CHAINS_LOG_FILE=

# --- API auth + rate limiting + usage metering ---
# When true, /analyze rejects requests without a valid bearer token.
# When false (default), unauthenticated calls are allowed and attributed to
# the "anonymous" principal. Set to true in production.
REQUIRE_AUTH=false

# Comma-separated list of token:name pairs. Names are the public identifier
# surfaced in logs and rate-limit buckets. Tokens never leave the auth module.
# Example: API_KEYS=tok_alpha:partner_a,tok_beta:partner_b
API_KEYS=

# Per-principal rate limits. Token-bucket: refills at RATE_LIMIT_PER_MINUTE
# requests/min, max burst of RATE_LIMIT_BURST tokens.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=30

# Path for the JSONL usage log (one record per /analyze call).
# Set to empty string to disable.
USAGE_LOG_FILE=

PORT=8787
