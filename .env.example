# Provider selection: "anthropic" or "azure_openai"
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Azure OpenAI (used when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Per-task overrides (optional). Use a faster deployment for extract,
# a smarter one for classify. Falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_EXTRACT_DEPLOYMENT=
AZURE_OPENAI_CLASSIFY_DEPLOYMENT=

# --- Web search (Tavily) — wired in step 4 ---
TAVILY_API_KEY=

# Path for the JSONL chain log. Default: ./data/chains.jsonl (relative to cwd).
# Set to empty string to disable.
CHAINS_LOG_FILE=

PORT=8787
