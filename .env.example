# Provider selection: "anthropic" or "azure_openai"
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Azure OpenAI (used when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Per-task overrides (optional). Use a faster deployment for extract,
# a smarter one for classify. Falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_EXTRACT_DEPLOYMENT=
AZURE_OPENAI_CLASSIFY_DEPLOYMENT=

# --- Web search providers ---
# All keys are optional. The backend uses every provider for which it has a key,
# fanning out in parallel and aggregating results. Users can also BYOK at request
# time via the extension Options page (chrome.storage.sync) — those override env.
#
# At least ONE provider must be configured (env or per-request BYOK) for /analyze
# to run. Skipping all of them returns 500 missing_config.

# Tavily — 1,000 searches/mo free tier. https://app.tavily.com
TAVILY_API_KEY=

# Brave Search — 2,000 queries/mo on Data for AI free tier (card on file).
# https://api.search.brave.com
BRAVE_API_KEY=

# Serper.dev — 2,500 one-time signup credits, then paid. https://serper.dev
SERPER_API_KEY=

# Bing Web Search (Azure Cognitive Services) — 1,000/mo on F1 tier.
# https://portal.azure.com → "Bing Search v7"
BING_API_KEY=

# Google Programmable Search Engine — 100 queries/day per CSE (tightest cap).
# Requires both an API key and a CSE id (cx).
# https://programmablesearchengine.google.com  +  https://console.cloud.google.com (Custom Search API)
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=

# Path for the JSONL chain log. Default: ./data/chains.jsonl (relative to cwd).
# Set to empty string to disable. Every analyzed claim + its provenance chain
# is appended here — useful telemetry, not required to run.
CHAINS_LOG_FILE=

PORT=8787
